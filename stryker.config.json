{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [".mutation-src/Core.js", ".mutation-src/Planner.js", ".mutation-src/Setup.js"],
  "testRunner": "command",
  "commandRunner": {"command": "COMMUTE_MUTATION=1 node --test test/*.test.cjs"},
  "mutator": {"excludedMutations": ["StringLiteral"]},
  "coverageAnalysis": "off",
  "concurrency": 3,
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "reporters": ["clear-text", "json", "html"],
  "clearTextReporter": {"allowColor": false, "logTests": false, "logMutants": false},
  "thresholds": {"high": 85, "low": 75, "break": 75},
  "tempDirName": ".stryker-tmp",
  "jsonReporter": {"fileName": "reports/mutation/mutation.json"},
  "htmlReporter": {"fileName": "reports/mutation/index.html"}
}
